{
  "sourceLanguage" : "en",
  "strings" : {
    "Accessibility permission is required to type." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要辅助功能权限才能模拟键入。"
          }
        }
      }
    },
    "After typing a code" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键入完成后"
          }
        }
      }
    },
