        }
      }
    },
    "Camera Access Needed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要相机权限"
          }
        }
      }
    },
    "Camera Unavailable" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机不可用"
          }
        }
      }
    },
    "Can't search for nearby Macs" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法搜索附近的 Mac"
