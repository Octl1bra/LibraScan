      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制"
          }
        }
      }
    },
    "Couldn't connect. Check that the Mac allowed the connection." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
