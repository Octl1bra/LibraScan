{
  "sourceLanguage" : "en",
  "strings" : {
    "Align a QR code or barcode within the frame" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将二维码或条形码对准框内"
