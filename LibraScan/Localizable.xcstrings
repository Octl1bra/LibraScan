    "Clear all scan records?" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要清空全部扫码记录吗？"
          }
        }
      }
    },
    "Codes you scan will show up here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫到的码会显示在这里。"
