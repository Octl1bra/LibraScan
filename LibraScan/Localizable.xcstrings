      }
    },
    "Download the latest Mac app" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载最新的 Mac 版"
          }
        }
      }
    },
    "Export Records" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出记录"
          }
        }
      }
    },
    "Failed to type on Mac" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键入 Mac 失败"
