    },
    "History" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录"
          }
        }
      }
    },
    "If no Macs appear, check that LibraScan is allowed to use the Local Network in Settings." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果找不到 Mac，请在「设置」中确认已允许 LibraScan 使用本地网络。"
          }
        }
      }
    },
    "LibraScan on the Mac is too old to understand this iPhone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 上的 LibraScan 版本过旧，无法与这台 iPhone 通信。"
          }
        }
      }
    },
    "LibraScan uses the camera to scan QR codes and barcodes. The camera feed is never saved or uploaded." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LibraScan 需要使用相机来扫描二维码和条形码，画面不会被保存或上传。"
          }
        }
      }
    },
    "Looking for nearby Macs…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在查找附近的 Mac…"
          }
        }
      }
    },
    "Mac app is out of date" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 端版本过旧"
          }
        }
